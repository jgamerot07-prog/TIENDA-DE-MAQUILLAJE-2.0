# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git.

# --- General ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=4000
# Origen permitido por CORS (URL del frontend)
WEB_ORIGIN=http://localhost:5173

# --- PostgreSQL local (docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# --- Prisma ---
# Formato: postgresql://USUARIO:CONTRASEÑA@localhost:PUERTO/BASEDEDATOS?schema=public
DATABASE_URL=
